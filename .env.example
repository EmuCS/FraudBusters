# Solana network for the registry and payouts (defaults to devnet when unset)
# RPC_URL=https://api.devnet.solana.com
# CLUSTER=devnet
# Pay.sh sandbox network instead (free airdrops):
# RPC_URL=https://402.surfnet.dev:8899
# CLUSTER=custom

# Claude photo assessment (required for fast-track): console.anthropic.com → API keys
# ANTHROPIC_API_KEY=
# Local demos without API credits: run the assessment through this machine's logged-in Claude Code
# CONTENT_CHECK_VIA=claude-code

# Payout stablecoin (npm run setup creates a test token when unset)
# PAYOUT_MINT=
# PAYOUT_SYMBOL=USDC

# Google Vision reverse image search via Pay.sh for uploaded photos (mainnet Pay.sh account)
# REVERSE_SEARCH=on
